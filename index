<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>แผนเที่ยวไทย 2 เดือน · Thailand 2-Month Plan</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;1,500&display=swap" rel="stylesheet">
<style>
:root{
  --navy:#1F3864; --navy2:#2c4f8a; --gold:#B8860B; --gold-l:#d4a92a;
  --cream:#F7F0DC; --bg:#f6f5f1; --ink:#222; --grey:#5c5c5c; --line:#e3ded2;
  --card:#ffffff; --shadow:0 6px 24px rgba(31,56,100,.08); --shadow-h:0 12px 36px rgba(31,56,100,.16);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;scroll-padding-top:70px}
body{font-family:'Noto Sans Thai',sans-serif;background:var(--bg);color:var(--ink);line-height:1.65;font-size:16px}
.en{font-size:.82em;color:var(--grey);font-style:italic;display:block;font-weight:400;margin-top:1px}
a{color:var(--navy2);text-decoration:none;border-bottom:1px dotted var(--gold)}
a:hover{color:var(--gold);border-bottom-style:solid}
.wrap{max-width:1080px;margin:0 auto;padding:0 18px}

/* HERO */
.hero{background:linear-gradient(135deg,#15264a 0%,#1F3864 55%,#33558f 100%);color:#fff;padding:54px 18px 40px;text-align:center;position:relative;overflow:hidden}
.hero:after{content:"🇹🇭";position:absolute;font-size:280px;opacity:.06;right:-30px;bottom:-70px}
.hero h1{font-family:'Playfair Display',serif;font-size:clamp(28px,5vw,46px);font-weight:600;letter-spacing:.5px}
.hero .sub-th{font-size:clamp(18px,3vw,26px);font-weight:700;margin-top:6px}
.hero .gold{color:var(--gold-l)}
.hero p{max-width:680px;margin:14px auto 0;opacity:.92;font-size:15px}
.stats{display:flex;flex-wrap:wrap;justify-content:center;gap:14px;margin-top:26px;position:relative;z-index:2}
.stat{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.22);border-radius:14px;padding:12px 20px;min-width:120px;backdrop-filter:blur(4px)}
.stat b{display:block;font-size:26px;color:var(--gold-l);font-weight:800}
.stat span{font-size:12.5px;opacity:.9}

/* NAV */
nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid var(--line);box-shadow:0 2px 10px rgba(0,0,0,.04)}
nav .wrap{display:flex;gap:6px;overflow-x:auto;padding:10px 18px;scrollbar-width:thin}
nav a{white-space:nowrap;border:0;font-size:13.5px;font-weight:600;color:var(--navy);padding:7px 13px;border-radius:20px;background:#eef1f6}
nav a:hover{background:var(--navy);color:#fff}

section{padding:38px 0 10px}
h2.sec{font-family:'Playfair Display',serif;font-size:27px;color:var(--navy);font-weight:600;display:flex;align-items:center;gap:10px;border-bottom:3px solid var(--gold);padding-bottom:8px;margin-bottom:6px}
h2.sec .num{background:var(--navy);color:#fff;width:34px;height:34px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:16px;font-family:'Noto Sans Thai';flex-shrink:0}
.sec-en{color:var(--gold);font-style:italic;font-size:14px;margin:-2px 0 18px 44px}
.lead{color:var(--grey);margin-bottom:18px}

/* alert */
.alert{background:#fff6e0;border:1px solid #f0d585;border-left:6px solid var(--gold);border-radius:12px;padding:16px 18px;margin:14px 0;display:flex;gap:12px}
.alert .ic{font-size:24px;flex-shrink:0}
.alert b{color:#7a5c00}
.tip{background:var(--cream);border-left:5px solid var(--gold);border-radius:10px;padding:12px 16px;margin:14px 0;font-size:14.5px}
.tip b{color:#7a5c00}

/* timeline */
.timeline{position:relative;margin:10px 0 0 12px;padding-left:26px;border-left:3px dashed var(--gold)}
.tl{position:relative;margin-bottom:20px;background:var(--card);border-radius:14px;box-shadow:var(--shadow);padding:14px 18px}
.tl:before{content:"";position:absolute;left:-34px;top:18px;width:16px;height:16px;border-radius:50%;background:var(--gold);border:3px solid #fff;box-shadow:0 0 0 2px var(--gold)}
.tl .ph{font-size:12px;color:var(--gold);font-weight:700;letter-spacing:1px;text-transform:uppercase}
.tl h3{color:var(--navy);font-size:18px;margin:2px 0 4px}
.tl .nights{display:inline-block;background:var(--navy);color:#fff;font-size:12px;font-weight:600;padding:2px 10px;border-radius:12px;margin-left:6px}
.tl p{font-size:14px;color:var(--grey)}
.tl.blank{background:repeating-linear-gradient(45deg,#fafafa,#fafafa 10px,#f0f0f0 10px,#f0f0f0 20px);border:2px dashed #c9b88a}
.tl.blank:before{background:#c9b88a;box-shadow:0 0 0 2px #c9b88a}

/* cards */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;margin-top:10px}
.card{background:var(--card);border-radius:16px;box-shadow:var(--shadow);overflow:hidden;transition:.2s}
.card:hover{box-shadow:var(--shadow-h);transform:translateY(-3px)}
.card .head{background:linear-gradient(120deg,var(--navy),var(--navy2));color:#fff;padding:14px 18px}
.card .head h3{font-size:19px;font-weight:700}
.card .head .he{font-size:12.5px;opacity:.85;font-style:italic}
.card .body{padding:14px 18px}
.hosp{font-size:13px;background:#eaf4ec;color:#1d6b3a;border-radius:8px;padding:6px 10px;margin-bottom:10px}
.hub{font-size:13px;background:#eef1f6;color:var(--navy);border-radius:8px;padding:6px 10px;margin-bottom:12px}
.lbl{font-size:13px;font-weight:700;color:var(--gold);text-transform:uppercase;letter-spacing:.5px;margin:12px 0 5px;border-bottom:1px solid var(--line);padding-bottom:3px}
.li{font-size:14px;margin:5px 0;padding-left:18px;position:relative}
.li:before{content:"›";position:absolute;left:2px;color:var(--gold);font-weight:700}
.tier{display:flex;gap:8px;font-size:13.5px;margin:5px 0;align-items:baseline}
.tier .t{font-weight:700;color:var(--navy);min-width:74px;flex-shrink:0}
.tier .pr{color:var(--gold);font-weight:700;white-space:nowrap}
.yellow{color:#a07a00;font-weight:700}

/* table */
table{width:100%;border-collapse:collapse;margin:12px 0;font-size:13.5px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:var(--shadow)}
th{background:var(--navy);color:#fff;padding:10px;text-align:left;font-weight:600}
td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
tr:nth-child(even) td{background:#f7f9fc}
.tot td{font-weight:800;background:var(--cream)!important;color:var(--navy)}

/* budget toggle */
.btns{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0 4px}
.btns button{font-family:inherit;cursor:pointer;border:2px solid var(--navy);background:#fff;color:var(--navy);font-weight:700;padding:9px 18px;border-radius:24px;font-size:14px;transition:.15s}
.btns button.on{background:var(--navy);color:#fff}
.bsum{font-size:14px;color:var(--grey);margin:8px 0}
.bsum b{color:var(--gold);font-size:18px}

/* checklist */
.check label{display:flex;gap:10px;align-items:flex-start;background:#fff;border-radius:10px;padding:11px 14px;margin:7px 0;box-shadow:var(--shadow);cursor:pointer;font-size:14.5px}
.check input{width:20px;height:20px;margin-top:2px;accent-color:var(--gold);flex-shrink:0}
.check input:checked + span{text-decoration:line-through;color:#aaa}

footer{background:var(--navy);color:#fff;text-align:center;padding:30px 18px;margin-top:40px}
footer .big{font-size:20px;font-weight:700;margin-bottom:6px}
footer .s{opacity:.7;font-size:12.5px;font-style:italic}
.collapse-h{cursor:pointer;user-select:none}
.collapse-h:after{content:" ▾";color:var(--gold)}
@media(max-width:600px){.hero{padding:40px 14px 30px}h2.sec{font-size:22px}.sec-en{margin-left:0}}
</style>
</head>
<body>

<header class="hero">
  <h1>A 2-Month Thailand Journey</h1>
  <div class="sub-th">แผนการเดินทาง<span class="gold">ประเทศไทย</span> 2 เดือน</div>
  <p>ธันวาคม – มกราคม · ออกแบบเส้นทางแบบไม่เร่งรีบ ปลอดภัย ใกล้โรงพยาบาล · สำหรับผู้เดินทาง 2 ท่าน<br><span class="en" style="display:inline">Central · North · South (Diving) · Isaan — designed for comfort, safety & proximity to top hospitals</span></p>
  <div class="stats">
    <div class="stat"><b>~55</b><span>คืน / nights</span></div>
    <div class="stat"><b>4</b><span>ภาค / regions</span></div>
    <div class="stat"><b>7</b><span>เมืองฐาน / hubs</span></div>
    <div class="stat"><b>฿336k+</b><span>งบเริ่มต้น 2 ท่าน</span></div>
  </div>
</header>

<nav><div class="wrap">
  <a href="#visa">⚠️ วีซ่า</a>
  <a href="#route">🗺️ เส้นทาง</a>
  <a href="#transport">🚐 เดินทาง</a>
  <a href="#hubs">🏨 ที่พัก+เที่ยว</a>
  <a href="#dive">🤿 ดำน้ำ</a>
  <a href="#senior">★ ดูแลผู้สูงวัย</a>
  <a href="#hospital">🏥 โรงพยาบาล</a>
  <a href="#budget">💰 งบ 3 ระดับ</a>
  <a href="#checklist">✅ เช็กลิสต์</a>
</div></nav>

<div class="wrap">

<!-- VISA -->
<section id="visa">
  <h2 class="sec"><span class="num">!</span> เรื่องวีซ่าที่ต้องตัดสินใจก่อน</h2>
  <div class="sec-en">Visa — decide before booking flights</div>
  <div class="alert">
    <div class="ic">⚠️</div>
    <div><b>ทริปนี้ ~60 วัน อยู่ "ขอบพอดี" ของสิทธิเดิม และเสี่ยงชนกฎใหม่</b><br>
    ขณะนี้ (พ.ค. 2026) พาสปอร์ตสหรัฐฯ ยังได้ยกเว้นวีซ่าสูงสุด 60 วัน + ต่อได้อีก 30 วัน (1,900 บาท) แต่ไทยเพิ่งอนุมัติ (19 พ.ค. 2026) จะ "ลด" เหลือ 30 วัน โดยยังไม่ประกาศวันบังคับใช้ →
    <b>แนะนำให้พ่อเลี้ยงยื่น Tourist e-Visa ล่วงหน้าจากสหรัฐฯ เพื่อความชัวร์</b>
    <span class="en">A ~60-day trip risks the new 30-day cap. Apply for a Tourist e-Visa in advance to be safe.</span></div>
  </div>
  <div class="li">กรอก <a href="https://tdac.immigration.go.th/" target="_blank">Thailand Digital Arrival Card (TDAC)</a> ออนไลน์ ก่อนถึงไทยอย่างน้อย 72 ชม. (ทุกคน)</div>
  <div class="li">เงื่อนไขล่าสุด: <a href="https://travel.state.gov/content/travel/en/international-travel/International-Travel-Country-Information-Pages/Thailand.html" target="_blank">travel.state.gov – Thailand</a> · ยื่นวีซ่า: <a href="https://www.thaievisa.go.th/" target="_blank">thaievisa.go.th</a></div>
</section>

<!-- ROUTE -->
<section id="route">
  <h2 class="sec"><span class="num">1</span> แผนภาพรวมเส้นทาง</h2>
  <div class="sec-en">Hub-and-Spoke Route — flexible dates, slot into your own calendar</div>
  <p class="lead">เลือก "เมืองฐาน" ไม่กี่จุด พักจุดละหลายคืน แล้วออกไปเที่ยวรอบๆ แบบไปเช้า-เย็นกลับ → ย้ายโรงแรมน้อย เหนื่อยน้อย ทุกฐานใกล้ รพ.เอกชนชั้นนำ · สภาพอากาศลงตัว: เหนือ+อีสานหนาวสบาย / อันดามันน้ำใสสุด ธ.ค.–ม.ค.</p>
  <div class="timeline">
    <div class="tl"><div class="ph">Phase 1 · ภาคกลาง</div><h3>กรุงเทพฯ — ปรับตัว <span class="nights">4–5 คืน</span></h3><p>พักเจ็ตแล็ก + วันลองรถไฟฟ้า BTS/MRT แบบไม่แออัด · ริมแม่น้ำ/สุขุมวิท<span class="en">Arrival & acclimatize + BTS/MRT trial day</span></p></div>
    <div class="tl"><div class="ph">Phase 2 · ภาคเหนือ</div><h3>เชียงใหม่ <span class="nights">8–10 คืน</span></h3><p>อากาศหนาวสบาย เที่ยวสบายๆ ของจริงภาคเหนือ · day trip รอบเมือง<span class="en">Cool, comfortable, authentic North</span></p></div>
    <div class="tl"><div class="ph">Phase 3 · ภาคเหนือ</div><h3>เชียงราย <span class="nights">3 คืน</span></h3><p>ภูเขา-ไร่ชา-วัดสวย อากาศเย็น · ต่อรถจากเชียงใหม่ ~3 ชม.<span class="en">Mountains, tea farms, temples</span></p></div>
    <div class="tl blank"><div class="ph">🚫 เว้นว่าง</div><h3>กรุงเทพฯ — คืนข้ามปี (ไอคอนสยาม)</h3><p>ที่พักจองแล้ว — ไม่จัดแผนคืนนี้<span class="en">NYE at ICONSIAM — pre-booked, intentionally left blank</span></p></div>
    <div class="tl"><div class="ph">Phase 5 · ภาคใต้</div><h3>เขาหลัก / ภูเก็ต <span class="nights">10–14 คืน</span></h3><p>ทะเลอันดามันน้ำใส + ทริปดำน้ำสิมิลันระดับโลก · พักผ่อน+ดำน้ำ<span class="en">Andaman sea + world-class Similan diving</span></p></div>
    <div class="tl"><div class="ph">Phase 6 · ภาคอีสาน</div><h3>อุดรธานี <span class="nights">5–7 คืน</span></h3><p>ทะเลบัวแดงบานสะพรั่งปลาย ม.ค. + วัฒนธรรมอีสานแท้ · แวะหนองคาย-โขง<span class="en">Red Lotus Sea peaks late Jan + authentic Isaan</span></p></div>
    <div class="tl"><div class="ph">Phase 7 · ปิดทริป</div><h3>กรุงเทพฯ — wrap-up <span class="nights">2–3 คืน</span></h3><p>ช้อป/พักผ่อน + (ออปชัน) ดูศูนย์ดูแลผู้สูงอายุ ก่อนบินกลับฮาวาย<span class="en">Wrap-up + optional senior-care tours</span></p></div>
  </div>
  <div class="tip"><b>💡 ปรับได้:</b> ถ้าคุณแม่อยากพักเพิ่ม ตัดเชียงรายหรือลดวันอีสานก่อน (ย้ายที่น้อย = เหนื่อยน้อย)</div>
</section>

<!-- TRANSPORT -->
<section id="transport">
  <h2 class="sec"><span class="num">2</span> การเดินทางระหว่างจุด</h2>
  <div class="sec-en">Transport Between Hubs</div>
  <p class="lead">วัย 65+: ระยะไกลข้ามภาค "บินเสมอ" (1–1.5 ชม.) · ระยะกลางใช้ "รถพร้อมคนขับ" · ในเมือง BTS/MRT + Grab</p>
  <table>
    <tr><th>เส้นทาง / Leg</th><th>ตัวเลือก / Options</th><th>ราคา (2 ท่าน)</th><th>หมายเหตุ</th></tr>
    <tr><td>กรุงเทพฯ ↔ เชียงใหม่</td><td>✈️ บิน 1 ชม.20 · 🚆 รถไฟตู้นอนชั้น 1 ขบวน 9 (~13 ชม.)</td><td>บิน ฿2,000–5,000<br>รถไฟ ฿2,900–4,900</td><td>บิน=ดีสุด · รถไฟ=ลองประสบการณ์เที่ยวเดียว</td></tr>
    <tr><td>เชียงใหม่ ↔ เชียงราย</td><td>🚐 รถพร้อมคนขับ ~3 ชม. (แวะไร่ชา/วัด)</td><td>฿2,500–3,800/วัน</td><td>แนะนำ — ยืดหยุ่น เที่ยวระหว่างทาง</td></tr>
    <tr><td>กรุงเทพฯ → ภูเก็ต/เขาหลัก</td><td>✈️ BKK→HKT + รถรับส่งไปเขาหลัก ~1 ชม.</td><td>บิน ฿2,400–6,000<br>รถ ฿1,500–2,500</td><td>บินตรง + รถส่วนตัวรับที่สนามบิน</td></tr>
    <tr><td>ภูเก็ต → อุดรธานี</td><td>✈️ ต่อเครื่องผ่าน BKK</td><td>฿4,000–8,000</td><td>บินครึ่งวัน เผื่อเวลาต่อเครื่อง</td></tr>
    <tr><td>อุดรธานี → กรุงเทพฯ</td><td>✈️ บิน 1 ชม. (เที่ยวบินถี่)</td><td>฿2,000–5,000</td><td>สบาย</td></tr>
    <tr><td>ในเมือง</td><td>🚆 BTS/MRT · 🚕 Grab · 🚐 เหมารถรายวัน</td><td>BTS ฿16–62 · Grab เริ่ม ฿60 · เหมา ฿2,000–2,500/วัน</td><td>Grab=ปลอดภัย ไม่ต้องต่อราคา</td></tr>
  </table>
  <div class="li">จองบิน: <a href="https://www.bangkokair.com/" target="_blank">Bangkok Airways</a> · <a href="https://www.thaiairways.com/" target="_blank">Thai Airways</a> · <a href="https://www.airasia.com/" target="_blank">AirAsia</a> · <a href="https://www.nokair.com/" target="_blank">Nok Air</a></div>
  <div class="li">รถไฟตู้นอน: <a href="https://dticket.railway.co.th/" target="_blank">D-Ticket การรถไฟ</a> · เหมารถ: <a href="https://www.orientalescape.com/transfer/thailand/period" target="_blank">Oriental Escape</a></div>
  <div class="tip"><b>💡 ข้อได้เปรียบคุณแม่เป็นคนไทย:</b> ต่อราคาเหมารถ/เรือ และเรียก Grab/แท็กซี่ในเรตคนไทย ไม่โดน "เรตฝรั่ง" — ประหยัดค่ารถ 20–40%</div>
</section>

<!-- HUBS -->
<section id="hubs">
  <h2 class="sec"><span class="num">3</span> ที่พัก + ร้านอาหาร + กิจกรรม</h2>
  <div class="sec-en">Stay · Eat · Do — by hub (3 hotel tiers each)</div>
  <p class="lead">โรงแรมคัดจากชื่อเสียงดี สะอาด ไม่มีประวัติด้านลบ · ร้าน "คนพื้นที่กินจริง" ไม่เอาร้านตอแหลฝรั่ง · กิจกรรม "ไม่ร้อน ไม่แออัด" · <span class="yellow">🟡 = ไกล รพ. เล็กน้อย แต่คุ้มค่า</span></p>
  <div class="grid">

    <div class="card">
      <div class="head"><h3>🏙️ กรุงเทพฯ</h3><div class="he">Bangkok · arrival + BTS/MRT trial</div></div>
      <div class="body">
        <div class="hosp">🏥 บำรุงราษฎร์ · สมิติเวช · BNH · รพ.กรุงเทพ (ระดับโลก JCI)</div>
        <div class="hub">🚐 Hub: BTS/MRT ทั้งเมือง · ท่าเรือสาทร · ไอคอนสยามมีเรือฟรี</div>
